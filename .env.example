# Offline writing works without X credentials. Generate a unique production secret
# with: openssl rand -base64 48
EDITOR_IMAGE=acks-x-article-editor:local
BRIDGE_IMAGE=acks-x-article-editor-bridge:local
EDITOR_PORT=5701
PUBLIC_BASE_URL=https://xeditor.acks.com.cn
X_SESSION_SECRET=replace-with-a-random-secret-never-commit
# selfhost: no experience-account limit. hosted: invite-only accounts and quotas.
DEPLOYMENT_MODE=selfhost
# Optional: zh-CN or en. Empty means browser-language detection.
DEFAULT_LANGUAGE=
