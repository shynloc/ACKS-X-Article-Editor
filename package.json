{
  "name": "acks-x-article-editor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 47631 --strictPort",
    "dev:bridge": "X_BRIDGE_PORT=48787 PUBLIC_BASE_URL=http://127.0.0.1:47631 X_BRIDGE_DB=.local/x-bridge.sqlite node server/x-bridge.mjs",
    "build": "node scripts/build-schema.mjs && tsc --noEmit && vite build && node scripts/prepare-sites-build.mjs && node scripts/build-offline.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build && node scripts/test-service-worker.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@phosphor-icons/react": "^2.1.10",
    "ajv": "^8.20.0",
    "decode-named-character-reference": "^1.3.0",
    "dexie": "^4.4.5",
    "fflate": "^0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.4.3",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <27"
  }
}
